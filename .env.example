# ── Database (Postgres) ──
DATABASE_URL=postgres://seesaw:CHANGE_ME@localhost:5432/seesaw

# ── Sessions ── generate with:  openssl rand -hex 32
AUTH_SECRET=

# Public address of the site (used for Google redirect URLs)
APP_URL=https://seesaw.sillar.uk

# ── Google sign-in (optional) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI:  https://seesaw.sillar.uk/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where uploaded files are kept (default ./storage)
STORAGE_DIR=/var/lib/seesaw/storage

PORT=8477
